branch="$(git rev-parse --abbrev-ref HEAD)"
pattern='^(main|(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)/[a-z0-9][a-z0-9._-]*)$'

if ! echo "$branch" | grep -Eq "$pattern"; then
  echo "✖ Nome de branch inválido: '$branch'"
  echo "  Use <tipo>/<descricao-curta>, por exemplo: feat/pagina-sobre ou fix/menu-mobile"
  echo "  Tipos: feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert"
  exit 1
fi

npm run typecheck
